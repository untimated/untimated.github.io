---
import { getSecret } from 'astro:env/server';

// Read the private repository at build time. Only the rendered text is published.
const token = getSecret('MONTWIG_GITHUB_TOKEN');
let message = '';
let commitUrl = 'https://github.com/untimated/montwig';

if (token) {
	try {
		const response = await fetch('https://api.github.com/repos/untimated/montwig/commits?per_page=1', {
			headers: {
				Accept: 'application/vnd.github+json',
				Authorization: `Bearer ${token}`,
			},
			signal: AbortSignal.timeout(5000),
		});
		if (!response.ok) throw new Error(`GitHub returned ${response.status}`);

		const [latest] = await response.json();
		if (latest?.commit?.message && latest.html_url) {
			message = latest.commit.message.split('\n')[0].trim();
			commitUrl = latest.html_url;
		}
	} catch {
		console.warn('[LatestCommit] Could not load Montwig’s latest commit; showing the project link.');
	}
} else {
	console.warn('[LatestCommit] Set MONTWIG_GITHUB_TOKEN to show Montwig’s latest commit.');
}
---

<p class="latest-commit">
	<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
		<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
	</svg>
	<a href={commitUrl} title={message || undefined}>Montwig{message && ` — ${message}`}</a>
</p>

<style>
	.latest-commit {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.latest-commit svg {
		flex-shrink: 0;
	}

	.latest-commit a {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
