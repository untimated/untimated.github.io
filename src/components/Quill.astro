---
// Decorative quill. Two artwork variants live in `public/`: a black-filled one
// for light backgrounds and a white-filled one for dark. `<picture>` + a
// `prefers-color-scheme` source lets the browser pick exactly one — no double
// download, and it re-evaluates if the reader flips their system theme.
//
// alt="" is deliberate: this is ornament, so screen readers should skip it.
interface Props {
	class?: string;
	/** Rendered width in px. Height is derived from the 389×430 viewBox. */
	width?: number;
}

const { class: className, width = 88 } = Astro.props;
const height = Math.round((width * 430) / 389);
---

<picture class:list={['quill', className]}>
	<source srcset="/quill_fill_white.svg" media="(prefers-color-scheme: dark)" />
	<img src="/quill_fill.svg" alt="" width={width} height={height} decoding="async" />
</picture>

<style>
	.quill {
		display: block;
	}

	.quill img {
		display: block;
		margin: 0 auto;
		max-width: 100%;
		height: auto;
	}
</style>
